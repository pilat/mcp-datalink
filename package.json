{
  "name": "@pilat/mcp-datalink",
  "version": "1.4.1",
  "description": "MCP server for secure database access (PostgreSQL, MySQL, SQLite)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-datalink": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest --run --exclude 'src/__integration__/**'",
    "test:coverage": "vitest --coverage --run --exclude 'src/__integration__/**'",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "lint": "eslint src"
  },
  "keywords": [
    "mcp",
    "database",
    "postgresql",
    "mysql",
    "sqlite",
    "claude",
    "claude-code",
    "model-context-protocol"
  ],
  "author": "Vladimir Urushev",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilat/mcp-datalink"
  },
  "license": "MIT",
  "homepage": "https://github.com/pilat/mcp-datalink",
  "mcpName": "io.github.pilat/mcp-datalink",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.6.0",
    "mysql2": "^3.19.1",
    "node-sql-parser": "^5.3.13",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mysql": "^12.0.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^10.0.2",
    "testcontainers": "^12.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.17"
  }
}
